let history={};try{history=JSON.parse(localStorage.getItem(&#x27;kaigo63-v1&#x27;)||&#x27;{}&#x27;)}catch(e){};
function save(){try{localStorage.setItem(&#x27;kaigo63-v1&#x27;,JSON.stringify(history))}catch(e){}}
function selectDomain(value){domain=value;query=&quot;&quot;;home()}
function home(){unit=null;document.body.dataset.domain=domain;app.innerHTML=`&lt;div class=&quot;brand&quot;&gt;STEP BY STEP&lt;/div&gt;&lt;h1&gt;ひとつずつ、&lt;ruby&gt;確&lt;rt&gt;たし&lt;/rt&gt;&lt;/ruby&gt;かな&lt;ruby&gt;力&lt;rt&gt;ちから&lt;/rt&gt;&lt;/ruby&gt;に。&lt;/h1&gt;&lt;p class=&quot;muted&quot;&gt;&lt;ruby&gt;領域&lt;rt&gt;りょういき&lt;/rt&gt;&lt;/ruby&gt;と&lt;ruby&gt;単元&lt;rt&gt;たんげん&lt;/rt&gt;&lt;/ruby&gt;をえらんで、はじめましょう。&lt;br&gt;1&lt;ruby&gt;単元&lt;rt&gt;たんげん&lt;/rt&gt;&lt;/ruby&gt;12&lt;ruby&gt;問&lt;rt&gt;もん&lt;/rt&gt;&lt;/ruby&gt;。こたえると、すぐに&lt;ruby&gt;解説&lt;rt&gt;かいせつ&lt;/rt&gt;&lt;/ruby&gt;がわかります。&lt;/p&gt;&lt;div class=&quot;tabs&quot;&gt;${domains.map((d,i)=&gt;`&lt;button data-domain=&quot;${i}&quot; class=&quot;tab ${domain===i?&#x27;active&#x27;:&#x27;&#x27;}&quot; onclick=&quot;selectDomain(${i})&quot;&gt;${d}&lt;small&gt;${counts[i]} &lt;ruby&gt;単元&lt;rt&gt;たんげん&lt;/rt&gt;&lt;/ruby&gt; · ${counts[i]*12}&lt;ruby&gt;問&lt;rt&gt;もん&lt;/rt&gt;&lt;/ruby&gt;&lt;/small&gt;&lt;/button&gt;`).join(&#x27;&#x27;)}&lt;/div&gt;&lt;div class=&quot;toolbar&quot;&gt;&lt;h2&gt;${domains[domain]}&lt;/h2&gt;&lt;input id=&quot;search&quot; aria-label=&quot;単元をさがす&quot; placeholder=&quot;キーワードでさがす&quot; value=&quot;&quot;&gt;&lt;/div&gt;&lt;div class=&quot;grid&quot; id=&quot;units&quot;&gt;&lt;/div&gt;&lt;p class=&quot;muted&quot; style=&quot;font-size:13px&quot;&gt;&lt;ruby&gt;学習記録&lt;rt&gt;がくしゅうきろく&lt;/rt&gt;&lt;/ruby&gt;は、このブラウザに&lt;ruby&gt;保存&lt;rt&gt;ほぞん&lt;/rt&gt;&lt;/ruby&gt;されます。&lt;/p&gt;`;document.getElementById(&#x27;search&#x27;).oninput=e=&gt;{query=e.target.value;cards()};cards()}
function cards(){document.getElementById(&#x27;units&#x27;).innerHTML=DATA.filter(u=&gt;u.domain===domain&amp;&amp;(`${u.n} ${u.name}`).includes(query)).map(u=&gt;`&lt;button data-domain=&quot;${u.domain}&quot; class=&quot;unit&quot; onclick=&quot;start(${u.n})&quot;&gt;&lt;span class=&quot;num&quot;&gt;UNIT ${u.n}&lt;/span&gt;&lt;b&gt;${u.title}&lt;/b&gt;&lt;small&gt;${history[u.n]?`${history[u.n].score} / 12 · まえのスコア`:&#x27;○× 10 + 5つからえらぶ 2&#x27;}　→&lt;/small&gt;&lt;/button&gt;`).join(&#x27;&#x27;)||&#x27;&lt;p&gt;みつかりませんでした。&lt;/p&gt;&#x27;}
function start(n){unit=DATA.find(x=&gt;x.n===n);domain=unit.domain;answers={};queue=unit.questions.map((_,i)=&gt;i);idx=0;review=false;show();window.scrollTo(0,0)}
function show(){document.body.dataset.domain=unit.domain;let qi=queue[idx],q=unit.questions[qi],answered=answers[qi]!==undefined;app.innerHTML=`&lt;button onclick=&quot;home()&quot;&gt;← &lt;ruby&gt;単元&lt;rt&gt;たんげん&lt;/rt&gt;&lt;/ruby&gt;をえらぶ&lt;/button&gt;&lt;div class=&quot;toolbar&quot;&gt;&lt;h2&gt;${unit.title}&lt;/h2&gt;&lt;span&gt;${idx+1} / ${queue.length}&lt;/span&gt;&lt;/div&gt;&lt;div class=&quot;progress&quot;&gt;&lt;span style=&quot;width:${(idx+1)/queue.length*100}%&quot;&gt;&lt;/span&gt;&lt;/div&gt;&lt;section class=&quot;panel&quot;&gt;&lt;div class=&quot;muted&quot;&gt;${qi+1} · ${qi&lt;10?&#x27;○×&#x27;:&#x27;5つから1つえらぶ&#x27;}&lt;/div&gt;&lt;div class=&quot;question&quot;&gt;${q.text}&lt;/div&gt;&lt;div class=&quot;options ${qi&lt;10?&#x27;tf&#x27;:&#x27;&#x27;}&quot;&gt;${q.options.map((s,i)=&gt;`&lt;button class=&quot;option ${answered?(i===q.answer?&#x27;correct &#x27;:&#x27;&#x27;)+(i===answers[qi]?(i===q.answer?&#x27;chosen&#x27;:&#x27;wrong&#x27;):&#x27;&#x27;):&#x27;&#x27;}&quot; ${answered?&#x27;disabled&#x27;:&#x27;&#x27;} onclick=&quot;answer(${i})&quot;&gt;${qi&lt;10?s:`&lt;span&gt;${i+1}.&lt;/span&gt; ${s}`}&lt;/button&gt;`).join(&#x27;&#x27;)}&lt;/div&gt;&lt;div id=&quot;feedback&quot; aria-live=&quot;polite&quot;&gt;${answered?feedback(q,answers[qi]):&#x27;&#x27;}&lt;/div&gt;&lt;div class=&quot;foot&quot;&gt;&lt;button onclick=&quot;idx--;show()&quot; ${idx===0?&#x27;disabled&#x27;:&#x27;&#x27;}&gt;← まえへ&lt;/button&gt;&lt;button class=&quot;primary&quot; ${!answered?&#x27;disabled&#x27;:&#x27;&#x27;} onclick=&quot;next()&quot;&gt;${idx===queue.length-1?&#x27;&lt;ruby&gt;結果&lt;rt&gt;けっか&lt;/rt&gt;&lt;/ruby&gt;をみる&#x27;:&#x27;つぎへ →&#x27;}&lt;/button&gt;&lt;/div&gt;&lt;/section&gt;&lt;div class=&quot;pills&quot;&gt;${queue.map((n,i)=&gt;`&lt;button class=&quot;${i===idx?&#x27;current&#x27;:&#x27;&#x27;}&quot; onclick=&quot;idx=${i};show()&quot; aria-label=&quot;問題${n+1}&quot;&gt;${n+1}${answers[n]!==undefined?&#x27; ✓&#x27;:&#x27;&#x27;}&lt;/button&gt;`).join(&#x27;&#x27;)}&lt;/div&gt;`}
function feedback(q,a){return `&lt;div class=&quot;feedback ${q.answer===a?&#x27;&#x27;:&#x27;bad&#x27;}&quot;&gt;&lt;strong&gt;${q.answer===a?&#x27;&lt;ruby&gt;正解&lt;rt&gt;せいかい&lt;/rt&gt;&lt;/ruby&gt;です！&#x27;:&#x27;もういちど、たしかめましょう。&#x27;}&lt;/strong&gt;&lt;p&gt;&lt;ruby&gt;正解&lt;rt&gt;せいかい&lt;/rt&gt;&lt;/ruby&gt;：${q.options.length===2?q.options[q.answer]:q.answer+1}&lt;/p&gt;${q.explanation}&lt;/div&gt;`}
function answer(a){answers[queue[idx]]=a;show()}
function next(){if(idx&lt;queue.length-1){idx++;show();window.scrollTo(0,0)}else result()}
function result(){let done=queue.filter(i=&gt;answers[i]!==undefined),wrong=queue.filter(i=&gt;answers[i]!==unit.questions[i].answer),score=queue.length-wrong.length;if(done.length&lt;queue.length){idx=queue.findIndex(i=&gt;answers[i]===undefined);show();return}if(!review){history[unit.n]={score,date:Date.now()};save()}app.innerHTML=`&lt;button onclick=&quot;home()&quot;&gt;← &lt;ruby&gt;単元&lt;rt&gt;たんげん&lt;/rt&gt;&lt;/ruby&gt;をえらぶ&lt;/button&gt;&lt;div class=&quot;panel&quot;&gt;&lt;div class=&quot;brand&quot;&gt;LESSON COMPLETE&lt;/div&gt;&lt;h2&gt;${unit.title}&lt;/h2&gt;&lt;p&gt;おつかれさまでした。&lt;/p&gt;&lt;div class=&quot;score&quot;&gt;${score}&lt;span style=&quot;font-size:24px&quot;&gt; / ${queue.length}&lt;/span&gt;&lt;/div&gt;&lt;p&gt;${wrong.length?&#x27;まちがえたところを、もういちど。&#x27;:&#x27;すべてできました！&#x27;}&lt;/p&gt;&lt;div class=&quot;foot&quot;&gt;${wrong.length?&#x27;&lt;button class=&quot;primary&quot; id=&quot;retry&quot;&gt;まちがえたところだけ&lt;/button&gt;&#x27;:&#x27;&#x27;}&lt;button onclick=&quot;start(${unit.n})&quot;&gt;はじめから&lt;/button&gt;${unit.n&lt;63?`&lt;button onclick=&quot;start(${unit.n+1})&quot;&gt;つぎの&lt;ruby&gt;単元&lt;rt&gt;たんげん&lt;/rt&gt;&lt;/ruby&gt; →&lt;/button&gt;`:&#x27;&#x27;}&lt;/div&gt;&lt;/div&gt;`;if(wrong.length)document.getElementById(&#x27;retry&#x27;).onclick=()=&gt;{queue=wrong;wrong.forEach(i=&gt;delete answers[i]);idx=0;review=true;show()}}
document.getElementById(&#x27;rubyToggle&#x27;).onclick=e=&gt;{let off=document.body.classList.toggle(&#x27;no-ruby&#x27;);e.target.textContent=&#x27;ふりがな：&#x27;+(off?&#x27;なし&#x27;:&#x27;あり&#x27;);e.target.setAttribute(&#x27;aria-pressed&#x27;,String(!off))};home();
&lt;/script&gt;&lt;/html&gt;
"></iframe>
